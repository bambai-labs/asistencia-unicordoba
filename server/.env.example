# ============================================
# Variables de Entorno - Backend
# ============================================

# Puerto del servidor
PORT=3000

# Entorno (development/production)
NODE_ENV=production

# URL del servidor
SERVER_URL=https://asistencia-unicor-api.bambai.tech

# Base de datos PostgreSQL
# Desarrollo local: postgresql://postgres:password@localhost:5432/asistencia_unicordoba
# Docker: postgresql://postgres:password@postgres:5432/asistencia_unicordoba
DATABASE_URL=postgresql://usuario:contraseña@localhost:5432/asistencia_unicordoba

# JWT Secret - CAMBIAR EN PRODUCCIÓN
# Genera uno seguro con: openssl rand -base64 64
JWT_SECRET=GENERA_UN_SECRETO_ALEATORIO_LARGO_Y_SEGURO_AQUI